generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PerfilUsuario { GARCOM COZINHA CAIXA ADMIN }
enum StatusMesa { LIVRE OCUPADA AGUARDANDO_CONTA }
enum StatusComanda { ABERTA FECHADA }
enum StatusPedido { NOVO PREPARANDO PRONTO ENTREGUE CANCELADO }
enum UnidadeInsumo { KG G UN L ML }
enum TipoMovimentacao { ENTRADA SAIDA_VENDA PERDA AJUSTE }
enum MetodoPagamento { DINHEIRO CARTAO PIX }
enum StatusPagamento { PENDENTE PAGO CANCELADO }

model Usuario {
  id Int @id @default(autoincrement())
  nome String
  email String @unique
  senhaHash String @map("senha_hash")
  perfil PerfilUsuario
  ativo Boolean @default(true)
  comandas Comanda[]
  caixas Caixa[]
  criadoEm DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  @@map("usuarios")
}

model Mesa {
  id Int @id @default(autoincrement())
  numero Int @unique
  capacidade Int
  status StatusMesa @default(LIVRE)
  comandas Comanda[]
  @@map("mesas")
}

model Categoria {
  id Int @id @default(autoincrement())
  nome String
  estacao String?
  produtos Produto[]
  @@map("categorias")
}

model Produto {
  id Int @id @default(autoincrement())
  categoriaId Int @map("categoria_id")
  categoria Categoria @relation(fields: [categoriaId], references: [id])
  nome String
  descricao String?
  preco Decimal @db.Decimal(10, 2)
  custoProducao Decimal? @map("custo_producao") @db.Decimal(10, 2)
  imagemUrl String? @map("imagem_url")
  disponivel Boolean @default(true)
  itensPedido ItemPedido[]
  fichaTecnica FichaTecnica[]
  @@index([categoriaId])
  @@map("produtos")
}

model Comanda {
  id Int @id @default(autoincrement())
  mesaId Int @map("mesa_id")
  garcomId Int @map("garcom_id")
  qtdPessoas Int @map("qtd_pessoas")
  status StatusComanda @default(ABERTA)
  abertaEm DateTime @default(now()) @map("aberta_em")
  fechadaEm DateTime? @map("fechada_em")
  mesa Mesa @relation(fields: [mesaId], references: [id])
  garcom Usuario @relation(fields: [garcomId], references: [id])
  pedidos Pedido[]
  pagamentos Pagamento[]
  @@index([mesaId, status])
  @@index([garcomId])
  @@map("comandas")
}

model Pedido {
  id Int @id @default(autoincrement())
  comandaId Int @map("comanda_id")
  status StatusPedido @default(NOVO)
  criadoEm DateTime @default(now()) @map("criado_em")
  comanda Comanda @relation(fields: [comandaId], references: [id])
  itens ItemPedido[]
  @@index([comandaId, criadoEm])
  @@map("pedidos")
}

model ItemPedido {
  id Int @id @default(autoincrement())
  pedidoId Int @map("pedido_id")
  produtoId Int @map("produto_id")
  quantidade Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  custoUnitario Decimal @map("custo_unitario") @db.Decimal(10, 2)
  observacao String?
  status StatusPedido @default(NOVO)
  criadoEm DateTime @default(now()) @map("criado_em")
  preparandoEm DateTime? @map("preparando_em")
  prontoEm DateTime? @map("pronto_em")
  entregueEm DateTime? @map("entregue_em")
  pedido Pedido @relation(fields: [pedidoId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])
  movimentacoes MovimentacaoEstoque[]
  @@index([pedidoId, status])
  @@index([produtoId])
  @@map("itens_pedido")
}

model Insumo {
  id Int @id @default(autoincrement())
  nome String
  unidade UnidadeInsumo
  quantidadeAtual Decimal @default(0) @map("quantidade_atual") @db.Decimal(12, 3)
  estoqueMinimo Decimal @default(0) @map("estoque_minimo") @db.Decimal(12, 3)
  custoUnitario Decimal @default(0) @map("custo_unitario") @db.Decimal(10, 4)
  fichaTecnica FichaTecnica[]
  movimentacoes MovimentacaoEstoque[]
  @@map("insumos")
}

model FichaTecnica {
  id Int @id @default(autoincrement())
  produtoId Int @map("produto_id")
  insumoId Int @map("insumo_id")
  quantidadeUsada Decimal @map("quantidade_usada") @db.Decimal(12, 4)
  produto Produto @relation(fields: [produtoId], references: [id])
  insumo Insumo @relation(fields: [insumoId], references: [id])
  @@unique([produtoId, insumoId])
  @@map("ficha_tecnica")
}

model MovimentacaoEstoque {
  id Int @id @default(autoincrement())
  insumoId Int @map("insumo_id")
  tipo TipoMovimentacao
  quantidade Decimal @db.Decimal(12, 4)
  custoUnitario Decimal @map("custo_unitario") @db.Decimal(10, 4)
  itemPedidoId Int? @map("item_pedido_id")
  criadoEm DateTime @default(now()) @map("criado_em")
  insumo Insumo @relation(fields: [insumoId], references: [id])
  itemPedido ItemPedido? @relation(fields: [itemPedidoId], references: [id])
  @@index([insumoId, criadoEm])
  @@index([itemPedidoId])
  @@map("movimentacoes_estoque")
}

model Despesa {
  id Int @id @default(autoincrement())
  descricao String
  categoria String
  valor Decimal @db.Decimal(10, 2)
  data DateTime
  recorrente Boolean @default(false)
  periodicidade String?
  @@index([data])
  @@map("despesas")
}

model Pagamento {
  id Int @id @default(autoincrement())
  comandaId Int @map("comanda_id")
  metodo MetodoPagamento
  valor Decimal @db.Decimal(10, 2)
  status StatusPagamento @default(PENDENTE)
  idTransacaoExterna String? @map("id_transacao_externa")
  pagoEm DateTime? @map("pago_em")
  comanda Comanda @relation(fields: [comandaId], references: [id])
  @@index([comandaId, status])
  @@map("pagamentos")
}

model Caixa {
  id Int @id @default(autoincrement())
  usuarioId Int @map("usuario_id")
  valorAbertura Decimal @map("valor_abertura") @db.Decimal(10, 2)
  valorFechamento Decimal? @map("valor_fechamento") @db.Decimal(10, 2)
  abertoEm DateTime @default(now()) @map("aberto_em")
  fechadoEm DateTime? @map("fechado_em")
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  @@index([usuarioId, abertoEm])
  @@map("caixas")
}
